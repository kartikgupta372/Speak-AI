# SPEAK Frontend — Environment Variables
# Copy to .env.local and fill in your values

# ── Backend API URL ────────────────────────────────────────────
# Dev: http://localhost:8000/api/v1 (no change needed)
# Prod: your Railway backend URL + /api/v1
#       e.g. https://speak-backend.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── API Key (must match FRONTEND_API_KEY in backend .env) ─────
# Dev: can be any string (or leave empty — auth is skipped in dev)
# Prod: set a strong secret (same value as FRONTEND_API_KEY in backend)
NEXT_PUBLIC_API_KEY=change-me-in-production
